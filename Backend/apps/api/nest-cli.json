{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "dtoFileNameSuffix": [".dto.ts", ".response.ts"]
        }
      }
    ],
    "assets": [
      {
        "include": "../../../database/migrations/**/*.sql",
        "outDir": "dist/database-migrations",
        "watchAssets": false
      }
    ]
  }
}
