# ─────────────────────────────────────────────────────────────────────────────
# BreadGuard AI — root environment template
#
# Copy to `.env` for docker-compose, and/or copy the per-app sections into
# apps/api/.env and services/ai/.env when running services directly.
#
# NEVER commit a filled-in .env. No real credentials belong in source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
#
# !! DEFINE `DATABASE_URL` EXACTLY ONCE. Pick Option A or Option B and comment
#    the other out. If both are left uncommented the last one silently wins,
#    which means you can migrate one database and run against another.
#
# !! docker-compose reads ONLY the .env next to docker-compose.yml, at the
#    repository root. It does NOT read apps/api/.env. If you set POSTGRES_PORT
#    in apps/api/.env, compose will not see it and will use the default below.
#
# These three are used only by docker-compose, to create the local container.
POSTGRES_USER=breadguard
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=breadguard
# Host port only, and it defaults to 5433 rather than 5432 because 5432 is
# where a locally installed Postgres usually already listens. Change it if
# 5433 is taken too, and update Option A's DATABASE_URL port to match.
# Containers always reach each other on 5432 over the private network.
POSTGRES_PORT=5433

# ── Option A (default): the local Postgres from docker-compose ───────────────
# Port 5433 matches POSTGRES_PORT above. This URL is used when you run the API
# directly (npm run dev:api) against the containerised database. If you run
# the API inside compose too, compose builds its own URL and ignores this.
# If you are pointing at your OWN locally installed Postgres instead, that is
# almost certainly on 5432 — change the port here.
DATABASE_URL=postgresql://breadguard:change-me-locally@localhost:5433/breadguard
DATABASE_SSL=false

# ── Option B: a hosted database such as Supabase ─────────────────────────────
# Use the *session pooler* / direct connection string from
# Supabase → Project Settings → Database. Comment out Option A above first.
#
# Percent-encode any special character in the password, or the URL parses
# wrongly and you get "password authentication failed" with no clue why:
#     @ -> %40      $ -> %24      / -> %2F      : -> %3A
#     # -> %23      ? -> %3F      & -> %26      space -> %20
# A password of `Pa@ss$word` must appear as `Pa%40ss%24word`.
# Simplest option: generate a password with letters and digits only.
#
# DATABASE_URL=postgresql://postgres.<ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
#
# NOTE: docker-compose ignores DATABASE_URL entirely — it builds its own from
# POSTGRES_USER/PASSWORD/DB pointing at the `postgres` container. To run the
# compose stack against a hosted database, override DATABASE_URL on the `api`
# service and drop the `postgres` dependency.

# ── Supabase (only needed when SUPABASE storage driver is selected) ──────────
STORAGE_DRIVER=local            # local | supabase
STORAGE_LOCAL_DIR=./.storage    # used when STORAGE_DRIVER=local
SUPABASE_URL=
# Service-role key is BACKEND ONLY. It must never reach a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sample-images
SIGNED_URL_TTL_SECONDS=300

# ── Auth / crypto ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48
JWT_ACCESS_TTL=900              # seconds (15 min)
JWT_REFRESH_TTL=1209600         # seconds (14 days)
REFRESH_COOKIE_NAME=bg_rt
# Set to the apex domain in production so the cookie is scoped correctly.
REFRESH_COOKIE_DOMAIN=
COOKIE_SECURE=false             # MUST be true in production (HTTPS)
COOKIE_SAMESITE=lax             # 'none' required for cross-site frontend+API

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist. No wildcards in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_GLOBAL_PREFIX=api
SWAGGER_ENABLED=true            # set false (or protect) in production
SWAGGER_PATH=api/docs
TRUST_PROXY=false               # true behind Render/Vercel/ingress

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760       # 10 MiB
MAX_IMAGE_PIXELS=50000000       # decompression-bomb guard
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_MAX=20

# ── Python AI service (internal; must NOT be publicly routable) ──────────────
AI_SERVICE_URL=http://localhost:8000
# Shared secret presented by the API as `x-internal-key`. Generate per env:
#   openssl rand -hex 32
AI_SERVICE_INTERNAL_KEY=replace-with-openssl-rand-hex-32
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_MAX_RETRIES=2
AI_SERVICE_MAX_CONCURRENCY=4

# ── AI service's own config (services/ai/.env) ───────────────────────────────
AI_PORT=8000
AI_INTERNAL_KEY=replace-with-openssl-rand-hex-32   # must equal AI_SERVICE_INTERNAL_KEY
AI_DOCS_ENABLED=true            # set false in production
AI_ARTIFACT_DIR=./artifacts
AI_MAX_IMAGE_BYTES=10485760
AI_MAX_IMAGE_PIXELS=50000000

# ── Email (optional — absence disables delivery cleanly) ─────────────────────
EMAIL_DRIVER=noop               # noop | resend
RESEND_API_KEY=
EMAIL_FROM=BreadGuard AI <no-reply@example.test>
APP_BASE_URL=http://localhost:5173

# ── Seed accounts (development only) ─────────────────────────────────────────
# If unset, the seed script generates random passwords and prints them once.
SEED_ADMIN_PASSWORD=
SEED_TECHNICIAN_PASSWORD=
SEED_REVIEWER_PASSWORD=
